machine(MachineType:L2Cache, "MESI Sparse Directory L2 Cache CMP")
 : CacheMemory * L2cache;
   CacheMemory * Directory;
   Cycles l2_request_latency := 2;
   Cycles l2_response_latency := 2;
   Cycles to_l1_latency := 1;
   CPUContainer *cpu;

  // Message Queues
  // From local bank of L2 cache TO the network
  MessageBuffer * DirRequestFromL2Cache, network="To", virtual_network="0",
    vnet_type="request";  // this L2 bank -> Memory

  MessageBuffer * L1RequestFromL2Cache, network="To", virtual_network="2",
    vnet_type="request";  // this L2 bank -> a local L1

  MessageBuffer * responseFromL2Cache, network="To", virtual_network="1",
    vnet_type="response";  // this L2 bank -> a local L1 || Memory

  // FROM the network to this local bank of L2 cache
  MessageBuffer * unblockToL2Cache, network="From", virtual_network="2",
    vnet_type="unblock";  // a local L1 || Memory -> this L2 bank

  MessageBuffer * L1RequestToL2Cache, network="From", virtual_network="0",
    vnet_type="request";  // a local L1 -> this L2 bank

  MessageBuffer * responseToL2Cache, network="From", virtual_network="1",
    vnet_type="response";  // a local L1 || Memory -> this L2 bank
{
  // STATES
  state_declaration(State, desc="L2 Cache controller states", default="L2Cache_State_NP_NC") {
    // L2 states
    NP, AccessPermission:Invalid, desc="Not present in L2";
    S, AccessPermission:Read_Only, desc="L2 cache entry Shared, clean";
    M, AccessPermission:Read_Write, desc="L2 cache entry Modified, dirty";

    // Directory states
    NC, AccessPermission:Invalid, desc="Not present in any L2";
    DS, AccessPermission:Read_Only, desc="cache entry Shared, present in one or more L1s";
    P, AccessPermission:Read_Write, desc="cache entry Private, one L1 has private access";

    // Controller states
    NP_NC, AccessPermission:Invalid, desc="Not present in either cache (no directory entry)";
    NP_S, AccessPermission:Invalid, desc="Not present in L2, but shared in one or more L1s (has a directory entry)";
    NP_P, AccessPermission:Invalid, desc="Not present in L2, but one L1 has private acces (has a directory entry)";
    S_NC, AccessPermission:Read_Only, desc="L2 cache entry Shared, not present in any L1s (no directory entry)";
    S_S, AccessPermission:Read_Only, desc="L2 cache entry Shared, also present in one or more L1s (has a directory entry)";
    S_P, AccessPermission:Maybe_Stale, desc="L2 cache entry Shared, one L1 has private access (has a directory entry)";
    M_NC, AccessPermission:Read_Write, desc="L2 cache entry Modified, not present in any L1s (no directory entry)";
    M_S, AccessPermission:Read_Write, desc="L2 cache entry Modified, also present in one or more L1s (has a directory entry)";
    M_P, AccessPermission:Maybe_Stale, desc="L2 cache entry Modified, one L1 has private access (has a directory entry)";

    // MEM_Inv
    NP_P_M_I, AccessPermission:Busy, desc="Invalidation from memory, waiting for data from private L1";
    S_M_I, AccessPermission:Busy, desc="Invalidation from memory, waiting for Acks from L1s";
    P_M_I, AccessPermission:Busy, desc="Invalidation from memory, waiting for Ack or data from private L1";


    // L2 replacement
    NC_NP_NC, AccessPermission:Busy, desc="L2 cache replacing, no need for Acks from L1s, sent Ack to memory, waiting for ACK from memory";
    S_NP_S, AccessPermission:Busy, desc="L2 cache replacing, no need for Acks from L1s, sent Ack to memory, waiting for ACK from memory";

    // Directory replacement
    NP_S_DR, AccessPermission:Busy, desc="Directory replacing, collecting acks from L1s";
    NP_P_DR, AccessPermission:Busy, desc="Directory replacing, collecting posible data from L1 if modified";
    S_S_DR, AccessPermission:Busy, desc="Directory replacing, collecting acks from L1s";
    S_P_DR, AccessPermission:Busy, desc="Directory replacing, collecting posible data from L1 if modified";
    M_S_DR, AccessPermission:Busy, desc="Directory replacing, collecting acks from L1s";
    M_P_DR, AccessPermission:Busy, desc="Directory replacing, collecting posible data from L1 if modified";

    // Transient States for fetching data from memory
    NPSS, AccessPermission:Busy, desc="L2 idle, got single L1_GETS, issued memory fetch, have not seen response yet";
    NPS, AccessPermission:Busy, desc="L2 idle, got L1_GET_INSTR or multiple L1_GETS, issued memory fetch, have not seen response yet";
    NPM, AccessPermission:Busy, desc="L2 idle, got L1_GETX, issued memory fetch, have not seen response(s) yet";

    // Blocking states
    NP_S_UMB, AccessPermission:Busy, desc="Blocked for L1_UPGRADE from NP_S";
    NP_P_MB, AccessPermission:Busy, desc="Blocked for L1_GETX, going to NP_P";
    S_NC_MB, AccessPermission:Busy, desc="Blocked for L1_GETS from S_NC";
    M_NC_MB, AccessPermission:Busy, desc="Blocked for L1_GETS from M_NC";

    // Forwarding
    P_IIB, AccessPermission:Busy, desc="Blocked for L1_GETS from X_P, waiting for unblock and data";
    P_IB, AccessPermission:Busy, desc="Blocked for L1_GETS from X_P, got unblock, waiting for data";

    S_P_SB, AccessPermission:Busy, desc="Blocked for L1_GETS from S_P, got data,  waiting for unblock";

    M_P_IIB, AccessPermission:Busy, desc="Blocked for L1_GETS from M_P, waiting for unblock and data";
    M_P_IB, AccessPermission:Busy, desc="Blocked for L1_GETS from M_P, got unblock, waiting for data";
    M_P_SB, AccessPermission:Busy, desc="Blocked for L1_GETS from M_P, got data,  waiting for unblock";

  }

  // EVENTS
  enumeration(Event, desc="L2 Cache events") {
    // L2 events

    // events initiated by the local L1s
    L1_GET_INSTR,            desc="a L1I GET INSTR request for a block maped to us";
    L1_GETS,                 desc="a L1D GETS request for a block maped to us";
    L1_GETX,                 desc="a L1D GETX request for a block maped to us";
    L1_UPGRADE,                 desc="a L1D GETX request for a block maped to us";

    L1_PUTX,                 desc="L1 replacing data";
    L1_PUTX_clean,           desc="L1 replacing clean data";
    L1_PUTX_old,             desc="L1 replacing data, but no longer sharer";

    // events initiated by this L2
    L2_Replacement,     desc="L2 Replacement", format="!r";
    Directory_Replacement,     desc="Directory Replacement", format="!r";

    // events from memory controller
    Mem_Data,     desc="data from memory", format="!r";
    Mem_Ack,     desc="ack from memory", format="!r";

    // M->S data writeback
    WB_Data,  desc="data from L1";
    WB_Data_clean,  desc="clean data from L1";
    Ack,      desc="writeback ack";
    Ack_all,      desc="writeback ack";

    Unblock, desc="Unblock from L1 requestor";
    Exclusive_Unblock, desc="Unblock from L1 requestor";

    MEM_Inv, desc="Invalidation from directory";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry") {
    State CacheState,         desc="cache entry state";
    DataBlock DataBlk,       desc="data for the block";
    bool Dirty, default="false", desc="data is dirty";
  }

  // DirectoryEntry
  structure(DirectoryEntry, desc="...", interface="AbstractCacheEntry", main="false") {
    State DirectoryState,          desc="directory entry state";
    NetDest Sharers,               desc="tracks the L1 shares on-chip";
    MachineID Exclusive,          desc="Exclusive holder of block";
  }

  // TBE fields
  structure(TBE, desc="...") {
    Addr addr,            desc="Physical address for this TBE";
    State TBEState,             desc="Transient state";
    DataBlock DataBlk,          desc="Buffer for the data block";
    bool Dirty, default="false", desc="Data is Dirty";

    MachineID Upgrader,              desc="ID of the L1 cache that made the upgrade request for this cache block";
    MachineID Requestor,             desc="ID of the L1 cache that made the request for this cache block";
    NetDest L1_GetS_IDs,            desc="Set of the internal processors that want the block in shared state";
    MachineID L1_GetX_ID,          desc="ID of the L1 cache to forward the block to once we get a response";
    int pendingAcks,            desc="number of pending acks for invalidates during writeback";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
    bool isEmpty();
  }

  TBETable TBEs, template="<L2Cache_TBE>", constructor="m_number_of_TBEs";

  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  Cycles ticksToCycles(Tick t);

  void set_cache_entry(AbstractCacheEntry a);
  void unset_cache_entry();
  void set_directory_entry(AbstractCacheEntry a);
  void unset_directory_entry();
  void set_tbe(TBE a);
  void unset_tbe();
  void wakeUpBuffers(Addr a);
  void profileMsgDelay(int virtualNetworkType, Cycles c);
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  // inclusive cache, returns L2 entries only
  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    return static_cast(Entry, "pointer", L2cache[addr]);
  }

  DirectoryEntry getDirectoryEntry(Addr addr), return_by_pointer="yes" {
    return static_cast(DirectoryEntry, "pointer", Directory[addr]);
  }

  bool isSharer(Addr addr, MachineID requestor, DirectoryEntry directory_entry) {
    if (is_valid(directory_entry)) {
      return directory_entry.Sharers.isElement(requestor);
    } else {
      return false;
    }
  }

  void addSharer(Addr addr, MachineID requestor, DirectoryEntry directory_entry) {
    assert(is_valid(directory_entry));
    DPRINTF(RubySlicc, "machineID: %s, requestor: %s, address: %#x\n",
            machineID, requestor, addr);
    directory_entry.Sharers.add(requestor);
  }

  State getState(TBE tbe, Entry cache_entry, DirectoryEntry directory_entry, Addr addr) {
    if(is_valid(tbe)) {
      if ((tbe.TBEState == State:NP_NC) || (tbe.TBEState == State:NP_S) || (tbe.TBEState == State:NP_P) || (tbe.TBEState == State:S_NC) ||
        (tbe.TBEState == State:S_S) || (tbe.TBEState == State:S_P) || (tbe.TBEState == State:M_NC) || (tbe.TBEState == State:M_S) ||
        (tbe.TBEState == State:M_P)) {
        assert(false);
      }
      return tbe.TBEState;
    } else if(is_valid(cache_entry)) {
      if (cache_entry.CacheState == State:S) {
        if (is_valid(directory_entry)) {
          if (directory_entry.DirectoryState == State:DS) {
            return State:S_S;
          }
          else {
            return State:S_P;
          } 
        } else {
          return State:S_NC;
        }
      } else {
        if (is_valid(directory_entry)) {
          if (directory_entry.DirectoryState == State:DS) {
            return State:M_S;
          }
          else {
            return State:M_P;
          } 
        } else {
          return State:M_NC;
        }
      }
    } else {
      if (is_valid(directory_entry)) {
        if (directory_entry.DirectoryState == State:DS) {
          return State:NP_S;
        }
        else {
          return State:NP_P;
        } 
      } else {
        return State:NP_NC;
      }
    }
    assert(false);
  }

  void setState(TBE tbe, Entry cache_entry, DirectoryEntry directory_entry, Addr addr, State state) {
    if ((state == State:NP_NC) || (state == State:NP_S) || (state == State:NP_P) || (state == State:S_NC) ||
        (state == State:S_S) || (state == State:S_P) || (state == State:M_NC) || (state == State:M_S) ||
        (state == State:M_P)) {
      assert(is_invalid(tbe));
      if (state == State:NP_NC) {
        assert(is_invalid(cache_entry));
        assert(is_invalid(directory_entry));
      }
      else if (state == State:NP_S) {
        assert(is_invalid(cache_entry));
        assert(is_valid(directory_entry));
        directory_entry.DirectoryState := State:DS;
      }
      if (state == State:NP_P) {
        assert(is_invalid(cache_entry));
        assert(is_valid(directory_entry));
        directory_entry.DirectoryState := State:P;
      }
      if (state == State:S_NC) {
        assert(is_valid(cache_entry));
        assert(is_invalid(directory_entry));
        cache_entry.CacheState := State:S;
      }
      if (state == State:S_S) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        cache_entry.CacheState := State:S;
        directory_entry.DirectoryState := State:DS;
      }
      if (state == State:S_P) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        cache_entry.CacheState := State:S;
        directory_entry.DirectoryState := State:P;
      }
      if (state == State:M_NC) {
        assert(is_valid(cache_entry));
        assert(is_invalid(directory_entry));
        cache_entry.CacheState := State:M;
      }
      if (state == State:M_S) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        cache_entry.CacheState := State:M;
        directory_entry.DirectoryState := State:DS;
      }
      if (state == State:M_P) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        cache_entry.CacheState := State:M;
        directory_entry.DirectoryState := State:P;
      }
    }
    else {
      assert(is_valid(tbe));
      tbe.TBEState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      DPRINTF(RubySlicc, "%s\n", L2Cache_State_to_permission(tbe.TBEState));
      return L2Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    DirectoryEntry directory_entry := getDirectoryEntry(addr);
    if(is_valid(cache_entry) || is_valid(directory_entry)) {
      DPRINTF(RubySlicc, "%s\n", L2Cache_State_to_permission(getState(tbe, cache_entry, directory_entry, addr)));
      return L2Cache_State_to_permission(getState(tbe, cache_entry, directory_entry, addr));
    }

    DPRINTF(RubySlicc, "%s\n", AccessPermission:NotPresent);
    return AccessPermission:NotPresent;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      testAndRead(addr, tbe.DataBlk, pkt);
    } else {
      testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
    }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;

    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes +
        testAndWrite(addr, tbe.DataBlk, pkt);
      return num_functional_writes;
    }

    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  void setAccessPermission(Entry cache_entry, DirectoryEntry directory_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L2Cache_State_to_permission(state));
    }
  }

  Event L1Cache_request_type_to_event(CoherenceRequestType type, MessageSizeType size, Addr addr,
                                      MachineID requestor, DirectoryEntry directory_entry) {
    if(type == CoherenceRequestType:GETS) {
      return Event:L1_GETS;
    } else if(type == CoherenceRequestType:GET_INSTR) {
      return Event:L1_GET_INSTR;
    } else if (type == CoherenceRequestType:GETX) {
      return Event:L1_GETX;
    } else if (type == CoherenceRequestType:UPGRADE) {
      if ( is_valid(directory_entry) && directory_entry.Sharers.isElement(requestor) ) {
        return Event:L1_UPGRADE;
      } else {
        return Event:L1_GETX;
      }
    } else if (type == CoherenceRequestType:PUTX) {
      if (isSharer(addr, requestor, directory_entry)) {
        if (size == MessageSizeType:Writeback_Data) {
          return Event:L1_PUTX;
        } else if (size == MessageSizeType:Writeback_Control) {
          return Event:L1_PUTX_clean;
        } 
      } else {
        return Event:L1_PUTX_old;
      }
    } else {
      DPRINTF(RubySlicc, "address: %#x, Request Type: %s\n", addr, type);
      error("Invalid L1 forwarded request type");
    }
  }

  int getPendingAcks(TBE tbe) {
    return tbe.pendingAcks;
  }

  bool isDirty(Entry cache_entry) {
    assert(is_valid(cache_entry));
    return cache_entry.Dirty;
  }

  // ** OUT_PORTS **

  out_port(L1RequestL2Network_out, RequestMsg, L1RequestFromL2Cache);
  out_port(DirRequestL2Network_out, RequestMsg, DirRequestFromL2Cache);
  out_port(responseL2Network_out, ResponseMsg, responseFromL2Cache);


  in_port(L1unblockNetwork_in, ResponseMsg, unblockToL2Cache, rank = 2) {
    if(L1unblockNetwork_in.isReady(clockEdge())) {
      peek(L1unblockNetwork_in,  ResponseMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        DirectoryEntry directory_entry := getDirectoryEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];
        DPRINTF(RubySlicc, "Addr: %#x State: %s Sender: %s Type: %s Dest: %s\n",
                in_msg.addr, getState(tbe, cache_entry, directory_entry, in_msg.addr),
                in_msg.Sender, in_msg.Type, in_msg.Destination);

        assert(in_msg.Destination.isElement(machineID));
        if (in_msg.Type == CoherenceResponseType:EXCLUSIVE_UNBLOCK) {
          trigger(Event:Exclusive_Unblock, in_msg.addr, cache_entry, tbe, directory_entry);
        } else if (in_msg.Type == CoherenceResponseType:UNBLOCK) {
          trigger(Event:Unblock, in_msg.addr, cache_entry, tbe, directory_entry);
        } else {
          error("unknown unblock message");
        }
      }
    }
  }

  // Response  L2 Network - response msg to this particular L2 bank
  in_port(responseL2Network_in, ResponseMsg, responseToL2Cache, rank = 1) {
    if (responseL2Network_in.isReady(clockEdge())) {
      peek(responseL2Network_in, ResponseMsg) {
        // test wether it's from a local L1 or an off chip source
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);
        DirectoryEntry directory_entry := getDirectoryEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if(machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
          if(in_msg.Type == CoherenceResponseType:DATA) {
            if (in_msg.Dirty) {
              trigger(Event:WB_Data, in_msg.addr, cache_entry, tbe, directory_entry);
            } else {
              trigger(Event:WB_Data_clean, in_msg.addr, cache_entry, tbe, directory_entry);
            }
          } else if (in_msg.Type == CoherenceResponseType:ACK) {
            if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
              trigger(Event:Ack_all, in_msg.addr, cache_entry, tbe, directory_entry);
            } else {
              trigger(Event:Ack, in_msg.addr, cache_entry, tbe, directory_entry);
            }
          } else {
            error("unknown message type");
          }

        } else { // external message
          if(in_msg.Type == CoherenceResponseType:MEMORY_DATA) {
              trigger(Event:Mem_Data, in_msg.addr, cache_entry, tbe, directory_entry);
          } else if(in_msg.Type == CoherenceResponseType:MEMORY_ACK) {
              trigger(Event:Mem_Ack, in_msg.addr, cache_entry, tbe, directory_entry);
          } else if(in_msg.Type == CoherenceResponseType:INV) {
              trigger(Event:MEM_Inv, in_msg.addr, cache_entry, tbe, directory_entry);
          } else {
            error("unknown message type");
          }
        }
      }
    }  // if not ready, do nothing
  }

  // L1 Request
  in_port(L1RequestL2Network_in, RequestMsg, L1RequestToL2Cache, rank = 0) {
    if(L1RequestL2Network_in.isReady(clockEdge())) {
      peek(L1RequestL2Network_in,  RequestMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        DirectoryEntry directory_entry := getDirectoryEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        DPRINTF(RubySlicc, "Addr: %#x State: %s Req: %s Type: %s Dest: %s\n",
                in_msg.addr, getState(tbe, cache_entry, directory_entry, in_msg.addr),
                in_msg.Requestor, in_msg.Type, in_msg.Destination);

        assert(machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache);
        assert(in_msg.Destination.isElement(machineID));

        if (is_valid(cache_entry)) {
          if (is_valid(directory_entry)) {
            // The L2 contains the block, so proceeded with handling the request
            trigger(L1Cache_request_type_to_event(in_msg.Type, in_msg.MessageSize, in_msg.addr,
                                                  in_msg.Requestor, directory_entry),
                    in_msg.addr, cache_entry, tbe, directory_entry);
          } else {
            if(Directory.cacheAvail(in_msg.addr)) {
              // Directory does't have the line, but we have space for it in the directory
              trigger(L1Cache_request_type_to_event(in_msg.Type, in_msg.MessageSize, in_msg.addr,
                                                    in_msg.Requestor, directory_entry),
                      in_msg.addr, cache_entry, tbe, directory_entry);
            } else {
              // No room in the Directory, so we need to make room before handling the request
              Addr victim := Directory.cacheProbe(in_msg.addr);
              Entry L2cache_entry := getCacheEntry(victim);
              DirectoryEntry directory_cache_entry := getDirectoryEntry(victim);
              trigger(Event:Directory_Replacement, victim, L2cache_entry, TBEs[victim], directory_cache_entry);
            }
          }
        } else {
          if (L2cache.cacheAvail(in_msg.addr)) {
            if (is_valid(directory_entry)) {
              // L2 does't have the line, but we have space for it in the L2
              trigger(L1Cache_request_type_to_event(in_msg.Type, in_msg.MessageSize, in_msg.addr,
                                                    in_msg.Requestor, directory_entry),
                      in_msg.addr, cache_entry, tbe, directory_entry);
            } else {
              if(Directory.cacheAvail(in_msg.addr)) {
                // Directory does't have the line, but we have space for it in the directory
                trigger(L1Cache_request_type_to_event(in_msg.Type, in_msg.MessageSize, in_msg.addr,
                                                      in_msg.Requestor, directory_entry),
                        in_msg.addr, cache_entry, tbe, directory_entry);
              } else {
                // No room in the Directory, so we need to make room before handling the request
                Addr victim := Directory.cacheProbe(in_msg.addr);
                Entry L2cache_entry := getCacheEntry(victim);
                DirectoryEntry directory_cache_entry := getDirectoryEntry(victim);
                trigger(Event:Directory_Replacement, victim, L2cache_entry, TBEs[victim], directory_cache_entry);
              }
            }
          } else {
            // No room in the L2, so we need to make room before handling the request
            Addr victim := L2cache.cacheProbe(in_msg.addr);
            Entry L2cache_entry := getCacheEntry(victim);
            DirectoryEntry directory_cache_entry := getDirectoryEntry(victim);
            trigger(Event:L2_Replacement, victim, L2cache_entry, TBEs[victim], directory_cache_entry);
          }
        }
      }
    }
  }


  // ACTIONS

  action(a_issueFetchToMemory, "a", desc="fetch data from memory") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(DirRequestL2Network_out, RequestMsg, l2_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;
      }
    }
  }

  action(b_forwardRequestToExclusive, "b", desc="Forward request to the exclusive L1") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, to_l1_latency) {
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(directory_entry.Exclusive);
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
      if (in_msg.Type == CoherenceRequestType:GETX || in_msg.Type == CoherenceRequestType:UPGRADE) {
        cpu.l2FwdGetXMissesPending(in_msg.Requestor.getNum());
      } else if (in_msg.Type == CoherenceRequestType:GETS) {
        cpu.l2FwdGetSMissesPending(in_msg.Requestor.getNum());
      }
    }
  }

  action(c_exclusiveReplacement, "c", desc="Send data to memory") {
    enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
  }

  action(c_exclusiveCleanReplacement, "cc", desc="Send ack to memory for clean replacement") {
    enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:ACK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(ct_exclusiveReplacementFromTBE, "ct", desc="Send data to memory") {
    enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
      assert(is_valid(tbe));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := tbe.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
  }

  action(d_sendDataToRequestor, "d", desc="Send data from cache to requestor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.AckCount := 0 - directory_entry.Sharers.count();
        if (directory_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
      }
    }
  }

  action(dd_sendExclusiveDataToRequestor, "dd", desc="Send data from cache to requestor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
        assert(is_valid(cache_entry));
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_EXCLUSIVE;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.AckCount := 0 -directory_entry.Sharers.count();
        if (directory_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
      }
    }
  }

  action(ds_sendSharedDataToRequestor, "ds", desc="Send data from cache to requestor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, l2_response_latency) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
      }
    }
  }

  action(e_sendDataToGetSRequestors, "e", desc="Send data from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() > 0);
    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

  action(ex_sendExclusiveDataToGetSRequestors, "ex", desc="Send data from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() == 1);
    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA_EXCLUSIVE;
        out_msg.Sender := machineID;
        out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

  action(ee_sendDataToGetXRequestor, "ee", desc="Send data from cache to GetX ID") {
    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
        assert(is_valid(tbe));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(tbe.L1_GetX_ID);
        DPRINTF(RubySlicc, "%s\n", out_msg.Destination);
        out_msg.DataBlk := in_msg.DataBlk;
        DPRINTF(RubySlicc, "Address: %#x, Destination: %s, DataBlock: %s\n",
                out_msg.addr, out_msg.Destination, out_msg.DataBlk);
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

  action(f_sendInvToSharers, "f", desc="invalidate sharers for L2 replacement") {
    enqueue(L1RequestL2Network_out, RequestMsg, to_l1_latency) {
      assert(is_valid(directory_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:INV;
      out_msg.Requestor := machineID;
      out_msg.Destination := directory_entry.Sharers;
      out_msg.MessageSize := MessageSizeType:Request_Control;
    }
  }

  action(f_sendInvFwd, "few", desc="invalidate exclusive sharer for MEM_Inv, forward data") {
    enqueue(L1RequestL2Network_out, RequestMsg, to_l1_latency) {
      assert(is_valid(directory_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:INV_FWD;
      out_msg.Requestor := machineID;
      out_msg.Destination := directory_entry.Sharers;
      out_msg.MessageSize := MessageSizeType:Request_Control;
    }
  }

  action(fw_sendFwdInvToSharers, "fw", desc="invalidate sharers for request") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, to_l1_latency) {
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination := directory_entry.Sharers;
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }

  action(fwm_sendFwdInvToSharersMinusRequestor, "fwm", desc="invalidate sharers for request, requestor is sharer") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, to_l1_latency) {
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination := directory_entry.Sharers;
        out_msg.Destination.remove(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }

  action(s_sendAckToGetXRequestor, "sack", desc="send Ack to update AckCount") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
        assert(is_valid(directory_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.AckCount := 0 - directory_entry.Sharers.count();
        if (directory_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
          APPEND_TRANSITION_COMMENT("Node ");
          APPEND_TRANSITION_COMMENT(in_msg.Requestor);
          APPEND_TRANSITION_COMMENT(" is sharer");
        }
        APPEND_TRANSITION_COMMENT( directory_entry.Sharers );
      }
    }
  }

  // OTHER ACTIONS
  action(i_allocateTBEMiss, "i", desc="Allocate TBE for request miss") {
    peek(L1RequestL2Network_in, RequestMsg) {
      check_allocate(TBEs);
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.L1_GetS_IDs.clear();
      tbe.Requestor := in_msg.Requestor;
      cpu.l3MissesPending(tbe.Requestor.getNum());
    }
  }

  action(i_allocateTBEL2, "i_invL2", desc="Allocate TBE for request") {
    check_allocate(TBEs);
    assert(is_valid(cache_entry));
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.L1_GetS_IDs.clear();
    tbe.DataBlk := cache_entry.DataBlk;
    tbe.Dirty := cache_entry.Dirty;
    tbe.Requestor := machineID;
  }

  action(i_allocateTBEDir, "i_invDir", desc="Allocate TBE for request") {
    check_allocate(TBEs);
    assert(is_valid(directory_entry));
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.L1_GetS_IDs.clear();
    tbe.Requestor := machineID;
    tbe.pendingAcks := directory_entry.Sharers.count();
  }

  action(i_allocateTBEMissDir, "i_invMmissDir", desc="Allocate TBE for request") {
    peek(L1RequestL2Network_in, RequestMsg) {
      check_allocate(TBEs);
      assert(is_valid(directory_entry));
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.L1_GetS_IDs.clear();
      tbe.Requestor := in_msg.Requestor;
      cpu.l3MissesPending(tbe.Requestor.getNum());
      tbe.pendingAcks := directory_entry.Sharers.count();
    }
  }

  action(i_allocateTBEUpgrd, "i_invUpgrd", desc="Allocate TBE for request") {
    peek(L1RequestL2Network_in,  RequestMsg) {
      check_allocate(TBEs);
      assert(is_valid(directory_entry));
      TBEs.allocate(address);
      set_tbe(TBEs[address]);
      tbe.L1_GetS_IDs.clear();
      tbe.Requestor := machineID;
      tbe.Upgrader := in_msg.Requestor;
      tbe.pendingAcks := directory_entry.Sharers.count();
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate external TBE") {
    MachineID node := TBEs.lookup(address).Requestor;
    NetDest nodes := TBEs.lookup(address).L1_GetS_IDs;
    TBEs.deallocate(address);
    unset_tbe();
    if(nodes.count() > 1) {
      cpu.l3NoMissesPending(nodes);
    } else if(machineIDToMachineType(node) == MachineType:L1Cache) {
      cpu.l3NoMissesPending(node.getNum());
    }
  }

  action(jj_popL1RequestQueue, "\j", desc="Pop incoming L1 request queue") {
    Tick delay := L1RequestL2Network_in.dequeue(clockEdge());
    profileMsgDelay(0, ticksToCycles(delay));
  }

  action(k_popUnblockQueue, "k", desc="Pop incoming unblock queue") {
    Tick delay := L1unblockNetwork_in.dequeue(clockEdge());
    profileMsgDelay(0, ticksToCycles(delay));
  }

  action(o_popIncomingResponseQueue, "o", desc="Pop Incoming Response queue") {
    Tick delay := responseL2Network_in.dequeue(clockEdge());
    profileMsgDelay(1, ticksToCycles(delay));
  }

  action(m_writeDataToCache, "m", desc="Write data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }

  action(mr_writeDataToCacheFromRequest, "mr", desc="Write data from response queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk := in_msg.DataBlk;
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }

  action(q_updateAck, "q", desc="update pending ack count") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.pendingAcks := tbe.pendingAcks - in_msg.AckCount;
      APPEND_TRANSITION_COMMENT(in_msg.AckCount);
      APPEND_TRANSITION_COMMENT(" p: ");
      APPEND_TRANSITION_COMMENT(tbe.pendingAcks);
    }
  }

  action(qq_writeDataToTBE, "\qq", desc="Write data from response queue to TBE") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.DataBlk := in_msg.DataBlk;
      tbe.Dirty := in_msg.Dirty;
    }
  }

  action(ss_recordGetSL1ID, "\s", desc="Record L1 GetS for load response") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(tbe));
      tbe.L1_GetS_IDs.add(in_msg.Requestor);
      if(tbe.Requestor != in_msg.Requestor) {
        cpu.l3MissesPending(in_msg.Requestor.getNum());
      }
    }
  }

  action(xx_recordGetXL1ID, "\x", desc="Record L1 GetX for store response") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(tbe));
      tbe.L1_GetX_ID := in_msg.Requestor;
    }
  }

  action(set_setMRU, "\set", desc="set the MRU entry") {
    L2cache.setMRU(address);
  }

  action(set_setDirMRU, "\setD", desc="set the directory MRU entry") {
    Directory.setMRU(address);
  }

  action(qq_allocateL2CacheBlock, "\q", desc="Set L2 cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L2cache.allocate(address, new Entry));
    }
  }

  action(qq_allocateDirectoryCacheBlock, "\qd", desc="Set L2 directory cache tag equal to tag of block B.") {
    if (is_invalid(directory_entry)) {
      set_directory_entry(Directory.allocate(address, new DirectoryEntry));
    }
  }

  action(rr_deallocateL2CacheBlock, "\r", desc="Deallocate L2 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    L2cache.deallocate(address);
    unset_cache_entry();
  }

  action(rr_deallocateDirectoryEntry, "\rd", desc="Deallocate L2 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    Directory.deallocate(address);
    unset_directory_entry();
  }

  action(t_sendWBAck, "t", desc="Send writeback ACK") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:WB_ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(ts_sendInvAckToUpgrader, "ts", desc="Send ACK to upgrader") {
    enqueue(responseL2Network_out, ResponseMsg, to_l1_latency) {
      assert(is_valid(directory_entry));
      assert(is_valid(tbe));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:ACK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(tbe.Upgrader);
      out_msg.MessageSize := MessageSizeType:Response_Control;
      // upgrader doesn't get ack from itself, hence the + 1
      out_msg.AckCount := 0 - directory_entry.Sharers.count() + 1;
    }
  }

  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    L2cache.profileDemandMiss();
  }

  action(uu_profileReadMiss, "\um0", desc="Profile the demand read miss") {
    L2cache.profileReadMisses();
  }

  action(uu_profileWriteMiss, "\um1", desc="Profile the demand write miss") {
    L2cache.profileWriteMisses();
  }

  action(uu_profileLoadMiss, "\um6", desc="Profile the demand load miss") {
    L2cache.profileLoadMisses();
  }

  action(uu_profileStoreMiss, "\um7", desc="Profile the demand store miss") {
    L2cache.profileStoreMisses();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    L2cache.profileDemandHit();
  }

  action(uu_profileReadHit, "\um2", desc="Profile the demand read hit") {
    L2cache.profileReadHits();
  }

  action(uu_profileWriteHit, "\um3", desc="Profile the demand write hit") {
    L2cache.profileWriteHits();
  }

  action(uu_profileLoadHit, "\um4", desc="Profile the demand load hit") {
    L2cache.profileLoadHits();
  }

  action(uu_profileStoreHit, "\um5", desc="Profile the demand store hit") {
    L2cache.profileStoreHits();
  }

  action(uu_profileConflict, "\um8", desc="Profile the conflict") {
    L2cache.profileConflicts();
  }

  action(nn_addSharer, "\n", desc="Add L1 sharer to list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(directory_entry));
      addSharer(address, in_msg.Requestor, directory_entry);
      APPEND_TRANSITION_COMMENT( directory_entry.Sharers );
    }
  }

  action(nnu_addSharerFromUnblock, "\nu", desc="Add L1 sharer to list") {
    peek(L1unblockNetwork_in, ResponseMsg) {
      assert(is_valid(directory_entry));
      addSharer(address, in_msg.Sender, directory_entry);
    }
  }

  action(kk_removeRequestSharer, "\k", desc="Remove L1 Request sharer from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(directory_entry));
      directory_entry.Sharers.remove(in_msg.Requestor);
    }
  }

  action(ll_clearSharers, "\l", desc="Remove all L1 sharers from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(directory_entry));
      directory_entry.Sharers.clear();
    }
  }

  action(mm_markExclusive, "\m", desc="set the exclusive owner") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(directory_entry));
      directory_entry.Sharers.clear();
      directory_entry.Exclusive := in_msg.Requestor;
      addSharer(address, in_msg.Requestor, directory_entry);
    }
  }

  action(mmu_markExclusiveFromUnblock, "\mu", desc="set the exclusive owner") {
    peek(L1unblockNetwork_in, ResponseMsg) {
      assert(is_valid(directory_entry));
      directory_entry.Sharers.clear();
      directory_entry.Exclusive := in_msg.Sender;
      addSharer(address, in_msg.Sender, directory_entry);
    }
  }

  action(zz_stallAndWaitL1RequestQueue, "zz", desc="recycle L1 request queue") {
    stall_and_wait(L1RequestL2Network_in, address);
  }

  action(zn_recycleResponseNetwork, "zn", desc="recycle memory request") {
    responseL2Network_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  //*****************************************************
  // TRANSITIONS
  //*****************************************************


  //===============================================
  // BASE STATE - NP_NC

  
  transition({NP_NC, NP_S, NPS, NPSS, NPM, S_NC, S_S, M_NC, M_S, NC_NP_NC, S_NP_S, S_M_I, M_P_IB, M_P_SB}, {L1_PUTX, L1_PUTX_clean}) {
    t_sendWBAck;
    uu_profileMiss;
    uu_profileReadMiss;
    jj_popL1RequestQueue;
  }

  transition({NP_NC, NP_S, NP_P, NPS, NPSS, NPM, S_NC, S_S, S_P, M_NC, M_S, M_P, NC_NP_NC, S_NP_S, S_M_I, M_P_IB, M_P_SB, NP_P_DR}, L1_PUTX_old) {
    t_sendWBAck;
    uu_profileMiss;
    uu_profileReadMiss;
    jj_popL1RequestQueue;
  }

  transition({NPSS, NPS, NPM, NP_S_UMB, NP_P_MB, S_NC_MB, M_NC_MB, S_NP_S, P_IIB, P_IB, S_P_SB, M_P_IIB, M_P_IB, M_P_SB}, {L2_Replacement, Directory_Replacement}) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({NPSS, NPS, NPM, NP_S_UMB, NP_P_MB, S_NP_S, S_NC_MB, M_NC_MB, S_S_DR, M_S_DR, S_P_DR, M_P_DR, P_IIB, P_IB, S_P_SB, M_P_IIB, M_P_IB, M_P_SB}, MEM_Inv) {
    zn_recycleResponseNetwork;
  }

  transition({NP_NC, NC_NP_NC, NP_S_DR, NP_P_DR, NP_P_M_I, S_M_I, P_M_I}, MEM_Inv) {
    uu_profileMiss;
    uu_profileWriteMiss;
    o_popIncomingResponseQueue;
  }

  transition({NP_S_UMB, NP_P_MB, S_NC_MB, M_NC_MB, P_IIB, P_IB, S_P_SB, M_P_IIB, M_P_IB, M_P_SB}, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE}) {
    zz_stallAndWaitL1RequestQueue;
  }

  // Transitions from NP_NC
  transition(NP_NC, L1_GETS, NPSS) {
    qq_allocateDirectoryCacheBlock;
    qq_allocateL2CacheBlock;
    ll_clearSharers;
    nn_addSharer;
    i_allocateTBEMiss;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    uu_profileReadMiss;

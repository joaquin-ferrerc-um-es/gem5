#!/bin/bash

SCRIPTS_DIR="$(dirname $(readlink -f "$0"))"
LAUNCH_DIR="$(pwd)"

JAR_FILE=results-scripts.jar
(
    cd "${SCRIPTS_DIR}/program"
    make --quiet "$JAR_FILE"
)

MEM="$(printf "24576\n$(($(grep "MemTotal:" /proc/meminfo | head -n1 | tr -s " " | cut -d" " -f2) * 4 / 7 / 1024))\n" | sort -n | head -n1)"
export JAVA_OPTS="${JAVA_OPTS:-Xmx${MEM}m}"

exec java -jar "${SCRIPTS_DIR}/program/${JAR_FILE}" "$@"
